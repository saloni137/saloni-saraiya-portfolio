---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Diagram from '../components/Diagram.astro';
import { projects } from '../data/projects';
import { profile, experience, skills } from '../data/profile';
---

<Layout home>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-eyebrow">
      <span class="status-dot"></span>
      <span>HELLO, I’M</span>
    </div>
    <div class="hero-main">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span class="hero-line">Saloni</span>
          <span class="hero-line">
            <em>Saraiya.</em>
          </span>
        </h1>
        <p class="hero-role">
          <span class="sr-only">Full-stack engineer, AI engineer and founding engineer.</span>
          <span class="typewriter" aria-hidden="true">
            <span id="typed-role">Full-stack & AI Engineer</span>
            <span class="typing-caret"></span>
          </span>
        </p>
        <div class="hero-details">
          <span>
            Founding Engineer at <strong>Notch</strong>
          </span>
          <span>
            Ottawa, Canada <i aria-hidden="true">·</i> Building since 2020
          </span>
        </div>
        <p>
          I build the whole thing: thoughtful interfaces, applied AI, and the reliable systems
          behind them.
        </p>
        <div class="hero-actions">
          <a class="text-link hero-cta" href="#work">
            Explore selected work{' '}
            <span class="round-arrow">
              <Arrow />
            </span>
          </a>
          <a class="hero-booking" href={profile.calendly} target="_blank" rel="noopener noreferrer">
            Book a call <Arrow diagonal />
          </a>
        </div>
      </div>
      <div
        class="hero-art"
        aria-label="My work connects human experience, applied AI and reliable systems"
        role="img"
      >
        <div class="art-orbit orbit-one"></div>
        <div class="art-orbit orbit-two"></div>
        <span class="art-note">
          THINK IN SYSTEMS.
          <br />
          BUILD FOR PEOPLE.
        </span>
        <div class="stack-sheet sheet-foundation">
          <span class="sheet-index">03 / UNDER THE SURFACE</span>
          <b>Make it reliable.</b>
          <div class="sheet-checks">
            <span>State ✓</span>
            <span>Recovery ✓</span>
            <span>Trust ✓</span>
          </div>
        </div>
        <div class="stack-sheet sheet-intelligence">
          <span class="sheet-index">02 / THE INTELLIGENCE</span>
          <b>Give it context.</b>
          <div class="node-route">
            <i></i>
            <span></span>
            <i></i>
            <span></span>
            <i></i>
          </div>
        </div>
        <div class="stack-sheet sheet-experience">
          <span class="sheet-index">01 / THE EXPERIENCE</span>
          <div class="sheet-headline">
            Start with
            <br />a <em>human.</em>
          </div>
          <span class="sheet-cursor">↗</span>
          <span class="sheet-caption">The details are the product.</span>
        </div>
        <div class="art-seal">
          <span>BUILT WITH</span>
          <b>intent</b>
          <span>FROM END TO END</span>
        </div>
      </div>
    </div>
    <div class="hero-footer">
      <span>From idea to interface to infrastructure.</span>
      <span class="scroll-cue">
        SCROLL TO CONNECT THE DOTS <span>↓</span>
      </span>
    </div>
  </section>

  <section class="manifesto wrap" aria-labelledby="manifesto-title">
    <div class="section-label">
      <span>01 / A POINT OF VIEW</span>
      <span>THE WAY I THINK</span>
    </div>
    <h2 id="manifesto-title" class="manifesto-text">
      <span>Good AI is more than a model.</span> <span>It’s the context, the interface,</span>{' '}
      <span>
        and what happens <em>when things get real.</em>
      </span>
    </h2>
    <div class="manifesto-bottom">
      <span class="asterisk" aria-hidden="true">
        ✳
      </span>
      <p>
        I work across those boundaries. At Notch, that means creative agents, thoughtful interfaces,
        payments, integrations and the production details that make everything hold together.
      </p>
    </div>
  </section>

  <section id="work" class="work-section" aria-labelledby="work-title">
    <div class="work-stage">
      <div class="work-heading wrap">
        <div>
          <span class="eyebrow">02 / SELECTED WORK</span>
          <h2 id="work-title">
            A few things
            <br />
            I’ve <em>seen through.</em>
          </h2>
        </div>
        <div class="work-controls">
          <span class="work-counter" aria-live="off">
            01 / 05
          </span>
          <div class="work-progress">
            <span></span>
          </div>
          <span class="work-scroll-hint">SCROLL TO EXPLORE →</span>
        </div>
      </div>
      <div class="project-track">
        {projects.map((project) => (
          <article class:list={['project-panel', `theme-${project.theme}`]}>
            <div class="project-copy">
              <div class="project-topline">
                <span>
                  {project.number} / {project.category}
                </span>
                <span>{project.period}</span>
              </div>
              <span class="project-company">{project.company}</span>
              <h3>{project.shortTitle}</h3>
              <p>{project.description}</p>
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <a class="project-link" href={`/work/${project.slug}/`}>
                Read the story <Arrow diagonal />
              </a>
            </div>
            <Diagram kind={project.visual} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="practice wrap" aria-labelledby="practice-title">
    <div class="section-label">
      <span>03 / BEYOND THE HAPPY PATH</span>
      <span>NOTES FROM PRACTICE</span>
    </div>
    <div class="practice-heading">
      <h2 id="practice-title">
        The work behind
        <br />
        <em>“it works.”</em>
      </h2>
      <p>
        I like the part where a vague problem becomes a clear explanation. A few lessons that have
        stayed with me.
      </p>
    </div>
    <div class="notes-list">
      <details class="practice-note">
        <summary>
          <span class="note-number">01</span>
          <h3>Sometimes the evaluator is the bug.</h3>
          <span class="note-tag">AI QUALITY</span>
          <span class="note-plus">+</span>
        </summary>
        <div class="note-body">
          <p>
            In pronunciation-repair research, a plausible transcript could hide an audible defect. I
            compared listening and transcript checks, examined false acceptance and kept script
            fidelity separate from phonetic hints. This work was a prototype and investigation, with
            limits that mattered as much as the successful examples.
          </p>
          <span class="note-lesson">Lesson / Evaluate the judge before trusting its verdict.</span>
        </div>
      </details>
      <details class="practice-note">
        <summary>
          <span class="note-number">02</span>
          <h3>A failed cache is not a failed render.</h3>
          <span class="note-tag">RELIABILITY</span>
          <span class="note-plus">+</span>
        </summary>
        <div class="note-body">
          <p>
            A browser-storage error made an export appear to fail while the server kept rendering. I
            traced the actual sequence, made optional persistence best-effort and bounded undo
            history. The fix made the interface tell the truth about the operation.
          </p>
          <span class="note-lesson">
            Lesson / Optional state should not overrule the source of truth.
          </span>
        </div>
      </details>
      <details class="practice-note">
        <summary>
          <span class="note-number">03</span>
          <h3>Ownership includes the way out.</h3>
          <span class="note-tag">PRODUCT CARE</span>
          <span class="note-plus">+</span>
        </summary>
        <div class="note-body">
          <p>
            I built portable exports for accumulated brand knowledge, turning memory and journals
            into readable Markdown archives. Streaming, filenames and access checks are small
            details until someone depends on them to take their work with them.
          </p>
          <span class="note-lesson">
            Lesson / A good product respects the work people put into it.
          </span>
        </div>
      </details>
    </div>
  </section>

  <section id="about" class="about-section wrap" aria-labelledby="about-title">
    <div class="section-label">
      <span>04 / THE PERSON BEHIND THE WORK</span>
      <span>HELLO, I’M SALONI</span>
    </div>
    <div class="about-grid">
      <div class="about-mark" aria-hidden="true">
        <span class="about-initial">
          S<span>.</span>
        </span>
        <svg viewBox="0 0 300 100" fill="none">
          <path d="M15 75c70-100 120 70 190-30s70-25 80-35" />
        </svg>
      </div>
      <div class="about-copy">
        <h2 id="about-title">
          A builder with
          <br />a <em>wide lens.</em>
        </h2>
        <p>
          I’m a full-stack engineer based in Ottawa. My work has taken me from commerce APIs and
          real-time systems to developer tools, retrieval pipelines and agentic products.
        </p>
        <p>
          I care about the whole experience: the sentence on a button, the context going into a
          model, the state after a payment, and the customer who finds the edge case.
        </p>
        <p>
          I use AI tools extensively, and I stay accountable for the result. My job is to frame the
          problem, challenge the first explanation and verify the behavior in the real product.
        </p>
        <a class="text-link" href="/resume/">
          The longer version <Arrow diagonal />
        </a>
      </div>
    </div>
    <div class="skills-grid">
      {skills.map((group) => (
        <div>
          <h3>{group.label}</h3>
          <p>{group.items.join(' · ')}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="experience-section wrap" aria-labelledby="experience-title">
    <div class="section-label">
      <span>05 / THE PATH SO FAR</span>
      <a href="/resume/">FULL RÉSUMÉ ↗</a>
    </div>
    <h2 id="experience-title" class="sr-only">
      Experience
    </h2>
    <div class="experience-list">
      {experience.map((job) => (
        <article class="experience-row">
          <span class="experience-date">{job.dates}</span>
          <div>
            <h3>{job.company}</h3>
            <span>{job.role}</span>
          </div>
          <p>{job.summary}</p>
        </article>
      ))}
    </div>
    <div class="side-projects">
      <div class="easygen-link">
        <span class="eyebrow">ALSO IN THE MIX / AGENTIC STUDIO</span>
        <div>
          <h3>EasyGen</h3>
          <p>
            A LinkedIn writing product I helped build from the start at Agentic Studio, contributing
            across most of its features.
          </p>
        </div>
        <a
          href="https://easygen.io/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit EasyGen"
        >
          View the product <Arrow diagonal />
        </a>
      </div>
      <article class="confidential-project">
        <span class="eyebrow">INDEPENDENT WORK / CONFIDENTIAL CLIENT</span>
        <div>
          <h3>
            Better tools.
            <br />
            Closer to the code.
          </h3>
          <p>
            Freelance engineering on developer tooling: editor interfaces, AI-assisted code
            workflows and version-control integration.
          </p>
        </div>
        <span class="confidential-note">
          Client identity and implementation details are kept private.
        </span>
      </article>
    </div>
  </section>
</Layout>
